# ────────────────────────────────────────────────────────────
# NOX / Ludo — environment variables (copy to .env / .env.local)
# NEVER commit real .env files. All values below are placeholders.
# ────────────────────────────────────────────────────────────

# ── Backend (Express + Socket.IO) ──────────────────────────
# PostgreSQL connection string (Neon/Supabase/RDS/…). Required.
DATABASE_URL="postgresql://user:password@localhost:5432/ludo_db"

# Secret used to sign JWTs. Required. Use a long random string:
#   openssl rand -hex 32
JWT_SECRET="replace_with_a_long_random_secret"

# Port the API server listens on (default 5000)
PORT=5000

# Comma-separated list of allowed browser origins for CORS.
# For local dev: http://localhost:3000
FRONTEND_URL="http://localhost:3000"

# ── Frontend (Next.js) ─────────────────────────────────────
# Backend origin used by the browser at build/runtime.
# - Same-origin deployment: leave empty (requests go to the same host).
# - Separate deployment: https://your-api.example.com
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
